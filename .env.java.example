# Copy to .env.java and replace both secrets before starting Compose.
POSTGRES_DB=yunlan
POSTGRES_USER=yunlan
JAVA_DATABASE_PASSWORD=replace-with-a-strong-database-password
JAVA_JWT_SECRET=replace-with-a-long-random-secret
APP_DEV_SEED_ENABLED=false
# Set SPRING_PROFILES_ACTIVE=real-learning-model only in an approved environment.
SPRING_PROFILES_ACTIVE=
LEARNING_MODEL_BASE_URL=
LEARNING_MODEL_API_KEY=
LEARNING_MODEL=gpt-4o-mini
LEARNING_MODEL_TIMEOUT_SECONDS=20
