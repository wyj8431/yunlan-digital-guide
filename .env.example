PORT=8787

# 推荐：hybrid 会优先使用扣子 Coze，失败或超时后自动使用火山方舟兜底。
# ARK_MODEL 填火山方舟控制台里的模型 ID 或推理接入点 ID。
LLM_PROVIDER=hybrid
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=glm-5-2-260617

# 扣子 Coze 智能体。hybrid/coze 模式会使用这些配置。
COZE_API_BASE=https://api.coze.cn
COZE_API_TOKEN=replace-with-your-coze-token
COZE_BOT_ID=replace-with-your-coze-bot-id
COZE_USER_ID=wyj-guide-user

# 可选：如果以后接其他 OpenAI-compatible 平台，填 LLM_* 会优先生效。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

XFYUN_VIRTUAL_HUMAN_ENABLED=false
XFYUN_VIRTUAL_HUMAN_APP_ID=replace-with-your-app-id
XFYUN_VIRTUAL_HUMAN_API_KEY=
XFYUN_VIRTUAL_HUMAN_API_SECRET=
XFYUN_VIRTUAL_HUMAN_APP_SECRET=replace-with-your-app-secret
XFYUN_VIRTUAL_HUMAN_SERVICE_ID=
XFYUN_VIRTUAL_HUMAN_AVATAR_ID=201165002
XFYUN_VIRTUAL_HUMAN_SDK_SCRIPT_URL=/libs/avatar-sdk-web_3.2.3.1002/esm/index.js
XFYUN_VIRTUAL_HUMAN_TTS_VOICE=x4_lingxiaoxuan_oral
XFYUN_VIRTUAL_HUMAN_ACTIONS=介绍:A_LH_introduced_O,双手介绍:A_RLH_introduced_O,右手介绍:A_RH_introduced_O,右手介绍2:A_RH_introduced1_O,欢迎:A_RLH_welcome_O,双手强调:A_RLH_emphasize_O,右手强调:A_RH_emphasize_O,右手强调2:A_RH_emphasize2_O,夸奖:A_RH_good_O,加油:A_RH_encourage_O,打招呼:A_RH_hello_O,再见:A_RH_bye_O,倾听点头:A_H_listen_C
XFYUN_TTS_APP_ID=
